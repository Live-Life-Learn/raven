{
  "doctype": "DocType",
  "name": "Raven User Theme",
  "module": "Raven",
  "issingle": 0,
  "custom": 0,
  "autoname": "field:theme_name",
  "fields": [
    {
      "fieldname": "theme_name",
      "fieldtype": "Data",
      "label": "Theme Name",
      "reqd": 1,
      "description": "Name of the theme"
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "label": "User",
      "options": "User",
      "description": "Owner of this theme (leave blank for global/workspace themes)"
    },
    {
      "fieldname": "theme_json",
      "fieldtype": "Code",
      "label": "Theme JSON",
      "options": "JSON",
      "reqd": 1,
      "description": "JSON configuration for theme variables"
    }
  ],
  "permissions": [
    {"role": "System Manager", "read":1, "write":1, "create":1, "delete":1},
    {"role": "Workspace Manager", "read":1, "write":1, "create":1},
    {"role": "All", "read":1, "write":1, "if_owner":1}
  ]
}
